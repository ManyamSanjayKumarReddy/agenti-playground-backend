# ── Internal service trust ──────────────────────────────────────────
# Shared secret with the ZeroTo control plane (mirrors its own
# node <-> control-plane x-internal-secret pattern). Every request to
# this service must send this value in the X-Internal-Secret header.
INTERNAL_SECRET=change-me-in-production

# ── LLM ───────────────────────────────────────────────────────────
# LLM_PROVIDER=groq uses Groq's hosted inference (reliable tool-calling,
# no self-hosted vLLM harmony-parsing bugs). Leave unset/"openai_compatible"
# to use the LLM_BASE_URL gateway below instead.
LLM_PROVIDER=groq
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-20b

# Self-hosted OpenAI-compatible gateway (used when LLM_PROVIDER is unset
# or "openai_compatible")
LLM_BASE_URL=
LLM_API_KEY=

# Fallback if LLM_BASE_URL/LLM_API_KEY are unset — get_llm() uses this directly
OPENAI_API_KEY=

# ── LangSmith (optional) ──────────────────────────────────────────
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentbay
