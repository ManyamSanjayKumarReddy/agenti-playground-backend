# ── Internal service trust ──────────────────────────────────────────
# Shared secret with the ZeroTo control plane (mirrors its own
# node <-> control-plane x-internal-secret pattern). Every request to
# this service must send this value in the X-Internal-Secret header.
INTERNAL_SECRET=change-me-in-production

# ── LLM (OpenAI-compatible gateway) ─────────────────────────────────
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Fallback if LLM_BASE_URL/LLM_API_KEY are unset — get_llm() uses these directly
OPENAI_API_KEY=
GROQ_API_KEY=

# ── LangSmith (optional) ──────────────────────────────────────────
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentbay
